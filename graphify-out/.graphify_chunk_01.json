    {"id": "readme_poc_overview", "label": "Architectural PDF Extraction POC (README)", "file_type": "document", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/README.md", "source_location": "# Architectural PDF Extraction (POC)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local Python CLI extracting doors, windows, walls/rooms, labels, and schedules from CAD-originated architectural PDFs via a vector-first heuristic pipeline with optional Gemini (Vertex AI) validation; Python 3.13, GCP project only needed for Gemini."},
