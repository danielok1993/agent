{
  "nodes": [
    {"id": "claude_vector_first_pipeline", "label": "Vector-First + Gemini-Validation Pipeline", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Project purpose", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Research question: whether CAD-originated PDFs carry enough native vector/text data that a vector-first heuristic pipeline plus Gemini validation beats vision-only extraction of doors, windows, walls, labels, and schedules."},
    {"id": "claude_seven_stage_pipeline", "label": "Seven-Stage Per-Page Pipeline", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Pipeline architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app.py is a thin argparse shell; the real flow is pipeline.py::run_extract looping pages through extract -> render -> pdfplumber cross-check -> heuristics -> Gemini -> merge -> overlay/JSON dump."},
    {"id": "claude_scale_normalization", "label": "150-DPI Coordinate Normalization (SCALE = 150/72)", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Pipeline architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All coordinates are normalized to 150-DPI pixel space at extraction time so detection, renderer, and Gemini bboxes share one coordinate space and heuristic bboxes overlay cleanly on the 150 DPI render; point-space must never reappear past extraction/extractor.py and extraction/plumber.py."},
    {"id": "claude_room_barrier_tiers", "label": "Four Barrier Tiers for Room Detection", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barriers are ALLOWLISTED wall evidence, not all linework: (1) wall solids from paired centerlines dilated to measured thickness, (2) wall-fill polygons rated per fill color, (3) thin buffers of qualifying faces only, (4) white background-fill rings. Room-interior ink (floor-tile grids, furniture, sanitary symbols, text masks) must not chop the free space; the union is morphologically closed (ROOM_GAP_CLOSE_PX) and components filtered by area, page fraction, border contact, hole fraction, erosion, wall-contact ratio and attachment to a major wall mass."},
    {"id": "claude_door_plugs", "label": "Door Wall-Plane Plugs (_door_plugs)", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A door bbox covers the swing (room floor, not wall), so it is replaced by thin plugs along its wall-plane edges, keeping the swing inside the room and splitting adjacent rooms exactly at the wall plane. An edge qualifies via the coverage profile of wall material hugging it (interrupted run with both end quarters anchored, or drawn-through plane with near-total coverage), sampled ROOM_OPENING_SEAL_PX past the bbox to reach jambs."},
    {"id": "claude_phantom_door_immunity", "label": "Phantom-Door Immunity in Room Sealing", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fallback-tier doors (DOOR_FALLBACK_CONFIDENCE 0.35, kept only for Gemini arbitration) seal exclusively through plugs carrying their own evidence: the interrupted-run doorway signature, or a drawn-through plane the plug actually lies in (>= ROOM_PLUG_IN_WALL_FRAC 0.80 of area on drawn wall; phantoms near a wall peak at ~0.77 while on-plane plugs measure 0.84+). Full coverage by mere proximity is NOT evidence - otherwise an annotation box hugging a wall band would stamp a free-space notch into the room outline. Bbox fallback requires confidence >= ROOM_OPENING_MIN_CONFIDENCE 0.40; doors are penalty-only in cross-validation so fallback tiers never climb back over."},
    {"id": "claude_white_wall_rings", "label": "White-Fill Hollow-Wall Ring Handling", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A white ring mostly covered by the text written inside it is a text mask and is dropped (WALL_WHITE_TEXT_COVER_FRAC). Textless band/post-sized rings are hollow-wall/joinery candidates accepted when touching wall material INCLUDING door/window bboxes (hollow runs are interrupted by their own openings; only doors >= ROOM_OPENING_MIN_CONFIDENCE anchor, so a phantom door on a white fixture cannot turn the fixture into wall). Runs are bridged across open spans with band-shaped convex hulls, but a bridge only closes an OPEN span: touching rings union into run components first, pairs are taken shortest-gap-first, and already-connected pairs never bridge - preventing the diagonal corner chord that notched room outlines around leader arrows."},
    {"id": "claude_marker_ring_exclusion", "label": "Arrowhead Marker-Ring Exclusion", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tiny 3-vertex triangles or concave 4-vertex darts up to WALL_MARKER_MAX_SIDE_PX (24px) bbox side (_FillRing.is_marker) are leader/dimension arrowheads drawn in the wall pen - walls are rectilinear, so a small triangle is never wall material. They are dropped from fill-class rating, barrier area, and wall-fill face qualification, while same-sized convex quads (jamb stubs, corner posts) stay."},
    {"id": "claude_fill_class_rating", "label": "Fill-Class Rating (_rate_fill_classes)", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closed rings reconstructed by chaining consecutive same-fill 'l' items (the Vectorworks filled-polygon signature); each fill COLOR is rated by the shape of its ink - run length in thin bands vs compact blocks, measured with area+perimeter equivalent-rectangle sides so L/U-shaped runs stay band-like. Wall-rated rings become barrier area, furniture-rated classes (cabinet blocks) are excluded entirely, unrated classes keep the permissive legacy rule."},
    {"id": "claude_text_cover_principle", "label": "Text-Cover Masking Principle", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A shape mostly covered by the text written inside it is annotation, not geometry. Applied to white rings (WALL_WHITE_TEXT_COVER_FRAC text masks) and to door candidates (ROOM_OPENING_TEXT_COVER_MAX 0.60 - 'WALL TYPE 1' tag boxes detected as leaf rectangles are dropped from the room stage entirely: no seals, no white-wall anchoring, no face exclusion). Real swing bboxes measure <= ~0.45 text cover even with a room label crossing them."},
    {"id": "claude_rooms_heuristic_only", "label": "Rooms Are Heuristic-Only", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Room candidates are never sent to Gemini, bypass merge thresholds and NMS, and are always promoted to heuristic-source entities carrying the closed polygon in Candidate.evidence['polygon'] / Entity.attributes['polygon']."},
    {"id": "claude_curved_wall_limitation", "label": "Curved-Wall and Joinery-Pen Limitations", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout (Room detection)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curved (Bezier) walls are out of scope - only straight 'l' faces and filled 're'/'qu' bands feed the wall network, so rooms bounded by curved walls leak open and are dropped. Boundaries drawn only in sub-threshold joinery pen (0.45px, same pen as sanitary fixtures) do not bound rooms; accepting that pen would reopen every fixture false positive, so the fix belongs to a future room-label/Gemini arbitration layer, not the barrier rules."},
    {"id": "claude_confidence_merge", "label": "Gemini/Heuristic Confidence Merge Strategy", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Pipeline architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "With Gemini: blended confidence 0.5*heuristic + 0.5*gemini (or max if higher), Gemini-rejected IDs drop out, unaddressed candidates fall back to heuristic-only. Without Gemini (--no-gemini): candidates below OFFLINE_MIN_CONFIDENCE[type] move to rejected and are not promoted to entities."},
    {"id": "claude_door_swing_topologies", "label": "Six Door Swing Topologies", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Algorithm reference", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full Bezier, chained Beziers, clean polyline, polyline + Y-junction stop, polyline + cycle cap, polyline + linear cap extension - catalogued with tunable constants, known false-positive patterns, and per-PDF detection state in docs/door-detection-tuning-guide.md."},
    {"id": "claude_debug_trace_workflow", "label": "Debug Trace Workflow (--debug)", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Commands", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--debug writes debug_trace.json plus a self-contained debug_viewer.html per page - a per-primitive detection trace for diagnosing missed/false door detections, following the tuning guide's debug-trace playbook."},
    {"id": "claude_output_contract", "label": "outputs/<timestamp> JSON Output Contract", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Output layout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-run summary.json and warnings.json at the root; per page: render.png, overlay.png, primitives.json, pdfplumber_comparison.json, candidates.json, gemini_result.json, final_entities.json, plus debug_trace.json/debug_viewer.html under --debug. The d61f0e2 refactor preserved this contract unchanged."},
    {"id": "claude_warning_conventions", "label": "Structured Warning Codes", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Warning codes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Warnings are structured dicts (warning_code, severity, message, page_number) in SCREAMING_SNAKE_CASE; the set is intentionally small and new warnings are emitted only from pipeline.collect_warnings, extraction.plumber.compare_counts, or gemini.client._validate_response."},
    {"id": "claude_data_model", "label": "Shared Dataclass Data Model (models.py)", "file_type": "concept", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Data model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PathPrimitive, TextSpan, ImageRef, PageData, Candidate, Entity live in models.py; BBox is (x0,y0,x1,y1) in 150-DPI pixels, top-left origin, y-down. Serialized page numbers are 1-based, internal page_indices 0-based. extract_paths explodes each get_drawings() entry into one PathPrimitive per atomic item so points[0]/points[-1] stay meaningful - do not re-bundle multi-item drawings."},
    {"id": "claude_detection_facade", "label": "Detection Package Facade", "file_type": "rationale", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Module layout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import from the detection facade (from detection import run_heuristics, detect_doors) rather than reaching into submodules; tunable constants are co-located with their detector (DOOR_* in doors/constants.py, WINDOW_*/WALL_*/ROOM_*/LABEL_*/SCHEDULE_* in matching detection/*.py, CROSS_* in postprocess.py). Tests import internals from their real homes - no compatibility shim. The d61f0e2 refactor split the 3,679-line heuristics.py monolith with behavior unchanged."},
    {"id": "docs_door_detection_tuning_guide", "label": "Door Detection Tuning Guide", "file_type": "document", "source_file": "/Users/danielszweda/Documents/GitHub/UD/agent/CLAUDE.md", "source_location": "## Algorithm reference", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must be read before changing door detection: catalogs the six swing topologies, every tunable constant with rationale, known false-positive patterns, per-PDF detection state to guard regressions, and the debug-trace diagnostic playbook."},
