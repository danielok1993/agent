+        # Linking past the touching tick read it as a chain-dash.
+        pieces = [
+            hline(50, 887.17, 979.17, 300), hline(51, 979.17, 982.92, 300),
+            hline(52, 985.17, 1333.67, 300), hline(53, 1335.67, 1339.42, 300),
+            hline(54, 1339.42, 1344.92, 300),
